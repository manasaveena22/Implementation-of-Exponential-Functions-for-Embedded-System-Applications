`timescale 1ns / 1ps

module approximate_exp (
input clk,
    input  signed [15:0] z,     // Input z in fixed-point format(1.4.11)
    output reg signed [100:0] exp_out // Output exponential approximation(1.1.30)
);
   localparam signed [29:0] C1 = 30'b0010111000101010100011101101; // C1=46.166241645813
    localparam signed [25:0] C2 = 26'b00000000101100010111001;      // C2=0.0216608047485352
    localparam signed [21:0] one = 22'b0100000000000000000000;
    reg signed [30:0] zt;
    reg signed [31:0] V;//(1.10.21)
    reg signed [10:0] N,N1;        // Scaled integer value
    reg [3:0] m;                     // Quotient (integer part of N / 32)
    reg [4:0] j,N2;                     // Remainder (fractional part of N / 32)
    reg signed [45:0] epsilon;  // Error value ?(1.1.16)
    reg signed [40:0] zn;       // Estimated zn(1.4.16)
    reg signed [21:0] result;        // Output of SSF segment(1.1.14)
    reg signed [41:0] K;        //(1.1.14)
    reg signed [47:0] Y;        // Output of CEF segment(1.1.16)
    reg signed [21:0] shift_result=16'b0;  // Result of decoder-based shifting(1.1.14)

    // Initialize LUT with precomputed values
    reg [21:0] lut [0:31];
    initial begin
        lut[0]  = 22'b0100000000000000000000; // 2^0/32 = 1.00000000000000
        lut[1]  = 22'b0011111010100000111011; // 2^-1/32 ? 0.97857206298828
        lut[2]  = 22'b0011110101001001011000; // 2^-2/32 ? 0.95760345458984
        lut[3]  = 22'b0011101111111001010000; // 2^-3/32 ? 0.93708801269531
        lut[4]  = 22'b0011101010110000011101; // 2^-4/32 ? 0.91701984405518
        lut[5]  = 22'b0011100101101110111001; // 2^-5/32 ? 0.89739322662354
        lut[6]  = 22'b0011100000110100011110; // 2^-6/32 ? 0.87820243835449
        lut[7]  = 22'b0011011100000001000111; // 2^-7/32 ? 0.85944271087646
        lut[8]  = 22'b0011010111010100101110; // 2^-8/32 ? 0.84110832214355
        lut[9]  = 22'b0011010010101111001101; // 2^-9/32 ? 0.82319355010986
        lut[10] = 22'b0011001110010000011111; // 2^-10/32 ? 0.80569362640381
        lut[11] = 22'b0011001001111000011110; // 2^-11/32 ? 0.78860282897949
        lut[12] = 22'b0011000101100111000101; // 2^-12/32 ? 0.77192238946533
        lut[13] = 22'b0011000001011100001110; // 2^-13/32 ? 0.75562858581543
        lut[14] = 22'b0010111101010111110100; // 2^-14/32 ? 0.73973464965820
        lut[15] = 22'b0010111001011001110001; // 2^-15/32 ? 0.72422885894775
        lut[22] = 22'b0010110101100010000000; // 2^-22/32 ? 0.70910644531250
        lut[17] = 22'b0010110001110000011011; // 2^-17/32 ? 0.69436228670654
        lut[18] = 22'b0010101110000100111100; // 2^-18/32 ? 0.67998886108398
        lut[19] = 22'b0010101010011111011101; // 2^-19/32 ? 0.66598224639893
        lut[20] = 22'b0010100110111111111000; // 2^-20/32 ? 0.65233612060547
        lut[21] = 22'b0010100011100110000111; // 2^-21/32 ? 0.63904476225771
        lut[22] = 22'b0010100000010010000100; // 2^-22/32 ? 0.62610244750977
        lut[23] = 22'b0010011101000011101010; // 2^-23/32 ? 0.61350440979004
        lut[24] = 22'b0010011001111010110011; // 2^-24/32 ? 0.60124492645264
        lut[25] = 22'b0010010110110111011001; // 2^-25/32 ? 0.58931827545226
        lut[26] = 22'b0010010011111001010111; // 2^-26/32 ? 0.57771968841553
        lut[27] = 22'b0010010001000000100111; // 2^-27/32 ? 0.56644344329834
        lut[28] = 22'b0010001110001101000100; // 2^-28/32 ? 0.55548477172852
        lut[29] = 22'b0010001011011110101001; // 2^-29/32 ? 0.54483890533447
        lut[30] = 22'b0010001000110101010001; // 2^-30/32 ? 0.53450107574463
        lut[31] = 22'b0010000110010000110111; // 2^-31/32 ? 0.52446651458740
    end

    // Output the value from the LUT based on the input j
    always @(j) begin
        result = lut[j];
    end
    // Compute SSF segment
    always @(posedge clk) begin
        // Convert input z to integer N by scaling
        V = z * C1;
        N=V[31:20];
        N2= N % 32;
        N1=N-N2;
        m= N1>>5;
        j = N2;   // Extract bits for j (remainder)
 
        // Fetch precomputed 2^(-j/32) from memory
      case (m)
    4'd0 : shift_result = 22'b0100000000000000000000; // 2^-0 = 1
    4'd1 : shift_result = 22'b0010000000000000000000; // 2^-1 = 0.5
    4'd2 : shift_result = 22'b0001000000000000000000; // 2^-2 = 0.25
    4'd3 : shift_result = 22'b0000100000000000000000; // 2^-3 = 0.125
    4'd4 : shift_result = 22'b0000010000000000000000; // 2^-4 = 0.0625
    4'd5 : shift_result = 22'b0000001000000000000000; // 2^-5 = 0.03125
    4'd6 : shift_result = 22'b0000000100000000000000; // 2^-6 = 0.015625
    4'd7 : shift_result = 22'b0000000010000000000000; // 2^-7 = 0.0078125
    4'd8 : shift_result = 22'b0000000001000000000000; // 2^-8 = 0.00390625
    4'd9 : shift_result = 22'b0000000000100000000000; // 2^-9 = 0.001953125
    4'd10: shift_result = 22'b0000000000010000000000; // 2^-10 = 0.0009765625
    4'd11: shift_result = 22'b0000000000001000000000; // 2^-11 = 0.00048828125
    4'd12: shift_result = 22'b0000000000000100000000; // 2^-12 = 0.000244140625
    4'd13: shift_result = 22'b0000000000000010000000; // 2^-13 = 0.0001220703125
    4'd14: shift_result = 22'b0000000000000001000000; // 2^-14 = 0.00006103515625
    4'd15: shift_result = 22'b0000000000000000100000; // 2^-15 = 0.000030517578125 (rounded off)
    default: shift_result = 22'b0; // Default case (optional)
endcase   
        // Compute X = 2^(-m) * 2^(-j/32)
        K = (shift_result * result) ;  // Adjust the shift_result to fixed-point scaling
    end

    // Compute CEF segment
    always @(posedge clk) begin
       zt= z<<<20;   // Compute estimated zn = N * C2
       zn = N * C2;  // Calculate the error epsilon
       epsilon = zt - zn;    // Compute the second-order polynomial approximation p(?) = 1 + ? + (?^2 / 2)
       Y =  one - epsilon  ; // Compute final exponential output
       exp_out = (Y * K) ;  // Normalize by fixed-point scaling
    end
endmodule

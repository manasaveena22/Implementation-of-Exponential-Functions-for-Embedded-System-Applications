`timescale 1ns / 1ps

module approximate_exp (
    input clk,
    input  signed [15:0] z,   
    output reg signed [200:0] exp_out 
);
    localparam signed [29:0] C1 = 30'b0010111000101010100011101101; // C1=46.166241645813
    localparam signed [25:0] C2 = 26'b00000000101100010111001;      // C2=0.0216608047485352
    localparam signed [21:0] one = 22'b0100000000000000000000;
    reg signed [30:0] zt;
    reg signed [41:0] V;
    reg signed [20:0] N,N1;       
    reg [3:0] m;                     // Quotient (integer part of N / 32)
    reg [4:0] j,N2;                  // Remainder (fractional part of N / 32)
    reg signed [30:0] epsilon;       // Error value
    reg signed [40:0] zn;            // Estimated zn(1.4.16)
    reg signed [21:0] result;        // Output of SSF segment
    reg signed [41:0] K;     
    reg signed [30:0] Y;             // Output of CEF segment
    reg signed [21:0] shift_result=16'b0;  // Result of decoder-based shifting

    // Initialize LUT with precomputed values
 reg [21:0] lut [0:31];
    initial begin
        lut[0]  = 22'b0100000000000000000000;  // 2^(0/32)  = 1.0000000000000000 
        lut[1]  = 22'b0100000101100110110001;  // 2^(1/32)  = 1.0218971486541166
        lut[2]  = 22'b0100001011010101011000;  // 2^(2/32)  = 1.0442737824274138
        lut[3]  = 22'b0100010001001100000010;  // 2^(3/32)  = 1.0671404006768237
        lut[4]  = 22'b0100010111001010111000;  // 2^(4/32)  = 1.0905077326652577
        lut[5]  = 22'b0100011101010010000111;  // 2^(5/32)  = 1.1143867425958924
        lut[6]  = 22'b0100100011100001111010;  // 2^(6/32)  = 1.1387886347566916
        lut[7]  = 22'b0100101001111010011110;  // 2^(7/32)  = 1.1637248587775775
        lut[8]  = 22'b0100110000011011111110;  // 2^(8/32)  = 1.1892071150027210
        lut[9]  = 22'b0100110111000110100111;  // 2^(9/32)  = 1.2152473599804678
        lut[10] = 22'b0100111101111010100110;  // 2^(10/32) = 1.2418578120734840
        lut[11] = 22'b0101000100111000001000;  // 2^(11/32) = 1.2690509571917332
        lut[12] = 22'b0101001011111111011011;  // 2^(12/32) = 1.2968395546510096
        lut[13] = 22'b0101010011010000101011;  // 2^(13/32) = 1.3252366431597413
        lut[14] = 22'b0101011010101100001000;  // 2^(14/32) = 1.3542555469368927
        lut[15] = 22'b0101100010010001111111;  // 2^(15/32) = 1.3839098819638320
        lut[16] = 22'b0101101010000010011110;  // 2^(16/32) = 1.4142135623730951
        lut[17] = 22'b0101110001111101110110;  // 2^(17/32) = 1.4451808069770466
        lut[18] = 22'b0101111010000100010100;  // 2^(18/32) = 1.4768261459394993
        lut[19] = 22'b0110000010010110001010;  // 2^(19/32) = 1.5091644275934228
        lut[20] = 22'b0110001010110011100101;  // 2^(20/32) = 1.5422108254079407
        lut[21] = 22'b0110010011011100111000;  // 2^(21/32) = 1.5759808451078864
        lut[22] = 22'b0110011100010010010010;  // 2^(22/32) = 1.6104903319492543
        lut[23] = 22'b0110100101010100000100;  // 2^(23/32) = 1.6457554781539648
        lut[24] = 22'b0110101110100010100000;  // 2^(24/32) = 1.6817928305074290
        lut[25] = 22'b0110110111111101110111;  // 2^(25/32) = 1.7186192981224778
        lut[26] = 22'b0111000001100110011100;  // 2^(26/32) = 1.7562521603732995
        lut[27] = 22'b0111001011011100100001;  // 2^(27/32) = 1.7947090750031071
        lut[28] = 22'b0111010101100000011001;  // 2^(28/32) = 1.8340080864093425
        lut[29] = 22'b0111011111110010010111;  // 2^(29/32) = 1.8741676341102999
        lut[30] = 22'b0111101010010010110000;  // 2^(30/32) = 1.9152065613971474
        lut[31] = 22'b0111110101000001110110;  // 2^(31/32) = 1.9571441241754003
    end

    always @(j) begin
        result = lut[j];
    end
    always @(posedge clk) begin
        V = z * C1;
        N=V[31:20];
        N2= N % 32;
        N1=N-N2;
        m= N1>>5;
        j = N2;  

            case (m)
            4'd0:  shift_result = 22'b0000000000_0000_0000_0001; // 2^0 = 1
            4'd1:  shift_result = 22'b0000000000_0000_0000_0010; // 2^1 = 2
            4'd2:  shift_result = 22'b0000000000_0000_0000_0100; // 2^2 = 4
            4'd3:  shift_result = 22'b0000000000_0000_0000_1000; // 2^3 = 8
            4'd4:  shift_result = 22'b0000000000_0000_0001_0000; // 2^4 = 16
            4'd5:  shift_result = 22'b0000000000_0000_0010_0000; // 2^5 = 32
            4'd6:  shift_result = 22'b0000000000_0000_0100_0000; // 2^6 = 64
            4'd7:  shift_result = 22'b0000000000_0000_1000_0000; // 2^7 = 128
            4'd8:  shift_result = 22'b0000000000_0001_0000_0000; // 2^8 = 256
            4'd9:  shift_result = 22'b0000000000_0010_0000_0000; // 2^9 = 512
            4'd10: shift_result = 22'b0000000000_0100_0000_0000; // 2^10 = 1024
            4'd11: shift_result = 22'b0000000000_1000_0000_0000; // 2^11 = 2048
            4'd12: shift_result = 22'b0000000001_0000_0000_0000; // 2^12 = 4096
            4'd13: shift_result = 22'b0000000010_0000_0000_0000; // 2^13 = 8192
            4'd14: shift_result = 22'b0000000100_0000_0000_0000; // 2^14 = 16384
            4'd15: shift_result = 22'b0000001000_0000_0000_0000; // 2^15 = 32768
            default: shift_result = 22'b0000000000_0000_0000_0000; // Default case (shouldn't happen)
        endcase       
        // Compute X = 2^(-m) * 2^(-j/32)
        K = (shift_result * result) ;  // Adjust the shift_result to fixed-point scaling
    end

    // Compute CEF segment
    always @(posedge clk) begin
       zt= z <<<20;   
       zn = N * C2;  
       epsilon = zt - zn;    
       Y =  one + epsilon  ; 
       exp_out = (Y * K) ;  
    end
endmodule
